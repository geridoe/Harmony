# Do not commit a populated .env file.
SPOTIFY_CLIENT_ID=
# Optional for PKCE where Spotify does not require confidential-client auth.
SPOTIFY_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
SPOTIFY_TOKEN_ENCRYPTION_KEY=

# APNs delivery worker. Keep the .p8 value server-side; for a local .env,
# preserve PEM newlines using a quoted multiline value.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
# Generate with: openssl rand -hex 32
APNS_WORKER_SECRET=
